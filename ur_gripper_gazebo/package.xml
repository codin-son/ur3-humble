<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_gripper_gazebo</name>
  <version>0.1.2</version>
  <description>Gazebo Classic simulation for the UR robot with a robotiq gripper</description>
  <author email="beltran@hlab.sys.es.osaka-u.ac.jp">Cristian Beltran</author>
  <maintainer email="beltran@hlab.sys.es.osaka-u.ac.jp">Cristian Beltran</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ur_gripper_description</depend>
  <depend>gazebo_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>robotiq_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
